      "shape": { "radius": "2px", "density": "1.05" },
      "fx": { "scanlines": "0", "vignette": "0", "bezel": "0", "headfill": "0", "gridline": "0.15", "ticks": "0" },
      "seriesMode": "form",
      "series": ["#c7493e", "#00b460", "#9b82e2", "#00c9df", "#86b54f", "#515ad1", "#991600", "#00a434"]
