{
  "$schema": "./tokens.schema.json",
  "version": 1,
  "description": "F-105 design tokens. Single source of truth for every platform: scripts/tokens-to-css.mjs emits src/design/themes.css for the web; a future scripts/tokens-to-swift.mjs emits the same values for iOS. Edit here, never in the generated CSS.",
  "defaultTheme": "terminal",
  "fonts": {
    "sans": "var(--font-geist-sans), 'Geist', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "mono": "var(--font-geist-mono), 'Geist Mono', ui-monospace, Menlo, monospace",
    "plex": "'IBM Plex Mono', var(--font-geist-mono), ui-monospace, Menlo, monospace",
    "serif": "'Source Serif 4 Variable', 'Source Serif 4', Georgia, 'Times New Roman', serif"
  },
  "series": {
    "dark": ["#3987e5", "#d95926", "#199e70", "#c98500", "#d55181", "#008300", "#9085e9", "#e66767"],
    "light": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948"]
  },
  "themes": {
    "terminal": {
      "name": "Terminal",
      "tagline": "Amber on black. The desk at 06:00.",
      "scheme": "dark",
      "fonts": { "ui": "sans", "data": "plex", "read": "serif" },
      "color": {
        "bg": "#0b0b0d", "bg-2": "#141417", "bg-3": "#070708",
        "line": "#26262c", "line-strong": "#3a3a42",
        "ink": "#ebe9e1", "ink-2": "#a9a8a0", "ink-3": "#6f6f78",
        "accent": "#ffb000", "accent-ink": "#141200",
        "up": "#2ed473", "down": "#ff5a4e", "warn": "#fab219", "alert": "#ff3b30",
        "glow": "rgba(255, 176, 0, 0.35)", "selection": "#ffb000"
      },
      "shape": { "radius": "2px", "density": "0.9" },
      "fx": { "scanlines": "0", "vignette": "0", "bezel": "1" }
    },
    "phosphor": {
      "name": "Phosphor",
      "tagline": "Green P1 tube. A 1982 scope with the room lights off.",
      "scheme": "dark",
      "fonts": { "ui": "plex", "data": "plex", "read": "plex" },
      "color": {
        "bg": "#041008", "bg-2": "#0a1a10", "bg-3": "#020805",
        "line": "#143a22", "line-strong": "#1f5a34",
        "ink": "#b9f5cc", "ink-2": "#7fd59a", "ink-3": "#46915f",
        "accent": "#3aff77", "accent-ink": "#041008",
        "up": "#3aff77", "down": "#ffb000", "warn": "#ffd166", "alert": "#ff6d4d",
        "glow": "rgba(58, 255, 119, 0.45)", "selection": "#3aff77"
      },
      "shape": { "radius": "0px", "density": "0.9" },
      "fx": { "scanlines": "0.22", "vignette": "0.55", "bezel": "1" }
    },
    "cockpit": {
      "name": "Cockpit",
      "tagline": "Grey panel, white needles, cyan cues. Instruments, not decoration.",
      "scheme": "dark",
      "fonts": { "ui": "sans", "data": "mono", "read": "sans" },
      "color": {
        "bg": "#111317", "bg-2": "#1b1e24", "bg-3": "#0b0c0f",
        "line": "#2b3038", "line-strong": "#3f4652",
        "ink": "#e8edf2", "ink-2": "#a5aeb9", "ink-3": "#68727f",
        "accent": "#5fd3ff", "accent-ink": "#06151c",
        "up": "#4ade80", "down": "#f87171", "warn": "#fbbf24", "alert": "#ff453a",
        "glow": "rgba(95, 211, 255, 0.3)", "selection": "#5fd3ff"
      },
      "shape": { "radius": "6px", "density": "1" },
      "fx": { "scanlines": "0", "vignette": "0", "bezel": "1" }
    },
    "bridge": {
      "name": "Bridge",
      "tagline": "Blue-white phosphor and brass. The CIC plot, first light.",
      "scheme": "dark",
      "fonts": { "ui": "plex", "data": "plex", "read": "serif" },
      "color": {
        "bg": "#04070e", "bg-2": "#0a1424", "bg-3": "#020409",
        "line": "#1a2b47", "line-strong": "#2a4370",
        "ink": "#cfe2ff", "ink-2": "#b9cdec", "ink-3": "#56719f",
        "accent": "#ffcf5c", "accent-ink": "#1a1200",
        "up": "#7ee0a8", "down": "#ff5a4e", "warn": "#ffcf5c", "alert": "#ff5a4e",
        "glow": "rgba(207, 226, 255, 0.4)", "selection": "#cfe2ff"
      },
      "shape": { "radius": "2px", "density": "0.95" },
      "fx": { "scanlines": "0.16", "vignette": "0.5", "bezel": "1" }
    },
    "paper": {
      "name": "Paper",
      "tagline": "Broadsheet stock, one red. For reading, not trading.",
      "scheme": "light",
      "fonts": { "ui": "sans", "data": "plex", "read": "serif" },
      "color": {
        "bg": "#f3efe6", "bg-2": "#fbf9f3", "bg-3": "#e9e4d8",
        "line": "#d6d0c2", "line-strong": "#b9b2a1",
        "ink": "#1c1b18", "ink-2": "#4e4b44", "ink-3": "#7f7b70",
        "accent": "#b02e26", "accent-ink": "#fff7f2",
        "up": "#1f7a3a", "down": "#b02e26", "warn": "#9a6b00", "alert": "#b02e26",
        "glow": "rgba(0, 0, 0, 0)", "selection": "#1c1b18"
      },
      "shape": { "radius": "2px", "density": "1.05" },
      "fx": { "scanlines": "0", "vignette": "0", "bezel": "0" }
    },
    "glass": {
      "name": "Glass",
      "tagline": "Light, layered, tactile. The phone in your hand.",
      "scheme": "light",
      "fonts": { "ui": "sans", "data": "mono", "read": "sans" },
      "color": {
        "bg": "#eef1f5", "bg-2": "#ffffff", "bg-3": "#e2e7ee",
        "line": "#d4dae3", "line-strong": "#b7c0cc",
        "ink": "#0b0f14", "ink-2": "#4b5563", "ink-3": "#8590a0",
        "accent": "#0a84ff", "accent-ink": "#ffffff",
        "up": "#1d9d4f", "down": "#e0352b", "warn": "#c77800", "alert": "#e0352b",
        "glow": "rgba(10, 132, 255, 0.25)", "selection": "#0a84ff"
      },
      "shape": { "radius": "12px", "density": "1.05" },
      "fx": { "scanlines": "0", "vignette": "0", "bezel": "1" }
    }
  }
}
