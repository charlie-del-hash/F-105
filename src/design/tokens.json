{
  "$schema": "./tokens.schema.json",
  "version": 1,
  "description": "F-105 design tokens. Single source of truth for every platform: scripts/tokens-to-css.mjs emits src/design/themes.css for the web; a future scripts/tokens-to-swift.mjs emits the same values for iOS. Edit here, never in the generated CSS.",
  "defaultTheme": "terminal",
  "autoNote": "What the Auto theme resolves to. A theme is an instrument, so following the OS needs a declared pair rather than a guess: the default desk when the system is dark, the phone theme when it is light.",
  "auto": { "dark": "terminal", "light": "glass" },
  "fonts": {
    "sans": "var(--font-geist-sans), 'Geist', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "mono": "var(--font-geist-mono), 'Geist Mono', ui-monospace, Menlo, monospace",
    "plex": "'IBM Plex Mono', var(--font-geist-mono), ui-monospace, Menlo, monospace",
    "serif": "'Source Serif 4 Variable', 'Source Serif 4', Georgia, 'Times New Roman', serif"
  },
  "seriesNote": "Per-theme categorical palettes. Each is the validated reference ring rotated so slot 1 is that theme's signature data colour — the line a single-series chart draws. OKLab ΔE is rotation-invariant in the (a,b) plane, so rotation inherits the reference's normal-vision separations; every ring was then re-validated against its own theme's bg-2 surface with the dataviz validator (lightness band, chroma floor, CVD separation, normal-vision floor, contrast). Assign by entity, never by rank; never cycle past eight. The scheme-level lists below are the fallback for a theme that declares none.",
  "series": {
    "dark": ["#3987e5", "#d95926", "#199e70", "#c98500", "#d55181", "#008300", "#9085e9", "#e66767"],
    "light": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948"]
  },
  "fxNote": "Functional skeuomorphism as dials, not forks. bezel: panel depth. scanlines/vignette: CRT furniture. headfill: how much of a panel header is a filled bar (1) versus a bare rule (0). gridline: chart gridline presence. ticks: instrument tick marks on inset edges.",
  "themes": {
    "terminal": {
      "name": "Terminal",
      "tagline": "Amber on black. The desk at 06:00.",
      "scheme": "dark",
      "fonts": { "ui": "sans", "data": "plex", "read": "serif" },
      "color": {
        "bg": "#0b0b0d", "bg-2": "#141417", "bg-3": "#070708",
        "line": "#26262c", "line-strong": "#3a3a42",
        "ink": "#ebe9e1", "ink-2": "#a9a8a0", "ink-3": "#6f6f78",
        "accent": "#ffb000", "accent-ink": "#141200",
        "up": "#2ed473", "down": "#ff5a4e", "warn": "#fab219", "alert": "#ff3b30",
        "glow": "rgba(255, 176, 0, 0.35)", "selection": "#ffb000"
      },
      "shape": { "radius": "2px", "density": "0.9" },
      "fx": { "scanlines": "0", "vignette": "0", "bezel": "1", "headfill": "1", "gridline": "0.6", "ticks": "0" },
      "seriesMode": "hue",
      "series": ["#bd7500", "#008ae7", "#bb6499", "#5096e9", "#009c8b", "#9a3ca5", "#9d9900", "#00a7b3"]
    },
    "phosphor": {
      "name": "Phosphor",
      "tagline": "Green P1 tube. A 1982 scope with the room lights off.",
      "scheme": "dark",
      "fonts": { "ui": "plex", "data": "plex", "read": "plex" },
      "color": {
        "bg": "#041008", "bg-2": "#0a1a10", "bg-3": "#020805",
        "line": "#143a22", "line-strong": "#1f5a34",
        "ink": "#b9f5cc", "ink-2": "#7fd59a", "ink-3": "#46915f",
        "accent": "#3aff77", "accent-ink": "#041008",
        "up": "#79ffab", "down": "#ffb000", "warn": "#ffd166", "alert": "#ff6d4d",
        "glow": "rgba(58, 255, 119, 0.45)", "selection": "#3aff77"
      },
      "shape": { "radius": "0px", "density": "0.9" },
      "fx": { "scanlines": "0.22", "vignette": "0.55", "bezel": "0", "headfill": "0", "gridline": "0.35", "ticks": "0" },
      "seriesMode": "form",
      "series": ["#2ba04a", "#8d6de4", "#c06f2e", "#c36ab3", "#2b87ea", "#bc3306", "#00ac97", "#7988f3"]
