        "accent": "#ffcf5c", "accent-ink": "#1a1200",
        "up": "#7ee0a8", "down": "#ff5a4e", "warn": "#ffcf5c", "alert": "#ff5a4e",
        "glow": "rgba(207, 226, 255, 0.4)", "selection": "#cfe2ff"
