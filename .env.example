# Copy to .env.local for local work. Every .env file is gitignored; this
# example is the one exception (see .gitignore).
#
# NOTHING HERE IS REQUIRED. The app builds and runs with an empty environment:
# every value below has a fallback or reports itself unconfigured, and no
# module throws on a missing one. Unset, the terminal serves deterministic
# synthetic market data and hides sign-in — which is exactly what the GitHub
# Pages demo does.

# ─── Do not set these on a server deployment ──────────────────────────────
# STATIC_EXPORT, NEXT_PUBLIC_STATIC_DEMO and PAGES_BASE_PATH are set by
# scripts/static-export.mjs for the GitHub Pages build alone. Setting any of
# them on Vercel turns the full app into the serverless demo: no API routes,
# no sign-in, no alert cron. They are listed here only so nobody adds them.

# ─── Site ─────────────────────────────────────────────────────────────────
# Absolute origin used for share links. Without it they read localhost:3000,
# which is harmless locally and wrong in production.
# NEXT_PUBLIC_SITE_URL=https://f-105.vercel.app

# ─── Market data ──────────────────────────────────────────────────────────
# A free FRED key (https://fred.stlouisfed.org/docs/api/api_key.html) turns on
# live energy and FX. Without it that adapter reports itself unconfigured and
# the deterministic mock generator supplies the series instead — still honest,
# because every quote carries `provider` and `synthetic` and the UI shows them.
# FRED_API_KEY=

# The ECB/Frankfurter adapter needs no key and is always on. Override the base
# URL only to point at a mirror.
# FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1

# Force a provider instead of the live-first chain. Mostly for debugging.
# MARKET_DATA_PROVIDER=live

# ─── Supabase: sign-in and cross-device sync ──────────────────────────────
# Optional. Without both public values the app stays on-device only: layouts
# and settings live in localStorage and the account page says sign-in is not
# configured.
#
# Two things are NOT just environment variables, and sign-in fails at the
# callback without them:
#   1. Apply supabase/migrations/20260918000000_workspaces.sql to the project.
#   2. Allow-list https://<your-site>/auth/callback in Supabase Auth settings.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so
# adding these to an existing deployment needs a redeploy, not just a save.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects call it the anon key; either name is accepted.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. BYPASSES ROW-LEVEL SECURITY — never in a NEXT_PUBLIC_ variable,
# never committed. Only the alert cron uses it, to dedupe against alert_log.
# Without it dedupe falls back to process memory, so a cold start can resend an
# alert that already went out.
# SUPABASE_SERVICE_ROLE_KEY=

# ─── Alerts ───────────────────────────────────────────────────────────────
# vercel.json runs /api/alerts/run daily at 06:00 UTC. Without CRON_SECRET the
# route is permanently a dry run — it evaluates rules and sends nothing — so a
# fresh deployment can never spam a channel. Setting it is what arms the cron.
# CRON_SECRET=

# At least one channel must be configured as well, or there is nowhere to send.
# Each is all-or-nothing: a partly configured channel reports what is missing
# and is skipped.
# SLACK_WEBHOOK_URL=

# RESEND_API_KEY=
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=                 # comma-separated

# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_RECIPIENTS=            # comma-separated E.164 numbers
# Meta requires an approved template for a cold send; without one the notifier
# sends free-form text, which only reaches a recipient inside an open window.
# WHATSAPP_TEMPLATE=
# WHATSAPP_TEMPLATE_LANG=en
