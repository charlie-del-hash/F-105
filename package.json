{
  "name": "f105-terminal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/tokens-to-css.mjs",
    "tokens:check": "node scripts/tokens-to-css.mjs --check",
    "prebuild": "node scripts/tokens-to-css.mjs",
    "content:check": "tsx scripts/validate-content.ts",
    "layouts:check": "tsx scripts/check-layouts.ts",
    "panels:check": "tsx scripts/check-panels.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "check": "pnpm tokens:check && pnpm lint && pnpm typecheck && pnpm content:check && pnpm layouts:check && pnpm panels:check && pnpm test",
    "build:static": "node scripts/static-export.mjs",
    "replay:assets": "node scripts/replay/fetch-terrain.mjs && node scripts/replay/bake-terrain.mjs",
    "replay:studio": "remotion studio",
    "replay:still": "remotion still",
    "replay:render": "remotion render"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@remotion/three": "4.0.541",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "cmdk": "^1.1.1",
    "geist": "^1.7.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-mdx-remote": "^6.0.0",
    "postprocessing": "6.39.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.541",
    "server-only": "^0.0.1",
    "three": "0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.541",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "geotiff": "3.0.5",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0",
  "description": "F-105 — an intelligence terminal: composable panels, user-built layouts, six instrument themes. Next.js 16 on Vercel.",
  "engines": {
    "node": ">=20.9"
  }
}
